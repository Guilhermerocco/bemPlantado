# Copie este arquivo para ".env" e preencha. NUNCA publique o ".env".

# Pl@ntNet  -> https://my.plantnet.org  (conta gratuita, chave em "API")
PLANTNET_API_KEY=

# Trefle    -> https://trefle.io  (token gratuito)
TREFLE_TOKEN=

# Local da planta (usado na previsão do tempo, Open-Meteo, sem chave)
LATITUDE=-23.55
LONGITUDE=-46.63

# Fonte dos dados do sensor: simulada (fictícia) | mqtt (caixinha real) | nenhuma
FONTE_DADOS=simulada
SIM_INTERVALO_SEG=30       # uma leitura fictícia a cada N segundos
SIM_HISTORICO_HORAS=72     # histórico fictício gerado ao iniciar
SIM_CENARIO=normal         # normal | calor | frio | seco  (para demonstrar os alertas)

# MQTT (caixinha real) — usado só quando FONTE_DADOS=mqtt. Troque GrupoX pelo nome do seu grupo.
MQTT_BROKER=test.mosquitto.org
MQTT_PORT=1883
MQTT_TOPIC=projeto_integrado/SENAI134/Cienciadedados/GrupoX

# Banco de dados (padrão: SQLite local)
DATABASE_URL=sqlite:///bemplantado.db

PORT=8080

# Chave que assina o cookie de login (contas). Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
